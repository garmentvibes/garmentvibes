# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# The server log the browser suites are run against. CI writes it
# (`npm run start > server.log`) and QA.md tells you to do the same locally, so
# it lands in the repo root every time anyone runs qa:routes or qa:e2e.
server.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase cli scratch
#
# The CLI writes a version cache here the first time it runs — it is machine
# state, not schema. The migrations, seed and tests in supabase/ are all
# tracked; only this directory is not.
supabase/.temp/
